{
    "name": "splicewire/laravel-beam-licenser",
    "description": "Server (issuer) + client (verifier) licensing for self-hosted Splicewire installs, wrapping masterix21/laravel-licensing and masterix21/laravel-licensing-client. LicenseIssuer issues/revokes licenses (marketplace fulfillment is a real issuer, not just a phone-home consumer); LicenseClient activates/verifies with an offline-grace window; LicenserEntitlementGate implements ADR-0023's EntitlementGate, sourced from the vendor's LicenseTemplate default_feature_restrictions. Deployment mode decides the gate: self-hosted installs bind this package's gate, SaaS installs never load it.",
    "keywords": [
        "laravel",
        "splicewire",
        "beam",
        "licensing",
        "entitlements",
        "self-hosted"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "masterix21/laravel-licensing": "2.2.1",
        "masterix21/laravel-licensing-client": "2.0.0",
        "spatie/laravel-data": "^4.0",
        "splicewire/laravel-beam-accounts": "*",
        "splicewire/laravel-beam-workflows": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "splicewire/laravel-beam-commerce": "*",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "suggest": {
        "splicewire/laravel-beam-commerce": "Supplies the EntitlementGate contract this package's self-hosted gate binds when beam.licenser.enabled is true. Without it the licence issuer and client still install, and the gate binding is skipped (extensions-live D1)."
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Licenser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Licenser\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Licenser\\BeamLicenserServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-accounts.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-commerce.git"
        },
        {
